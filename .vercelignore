# Vercel Deploy Exclusions
# Vercel builds from source — no need to upload build artifacts

# Next.js build output (Vercel builds this on their servers)
.next/
out/

# Node modules (Vercel installs these)
node_modules/

# Local environment files (set as Vercel env vars instead)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Instagram/social media exports (not used by the website)
instagram_export/

# Brand Library (large .docx and design files - not needed at runtime)
Vriksh Vani Brand Library/

# Info files (planning docs - not needed at runtime)
Vriksh Vani info files/

# Website planning docs
Website Pages & Sections/

# Editor configs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Test outputs
coverage/
playwright-report/
test-results/

# Vercel CLI local config
.vercel/
