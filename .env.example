# Vriksh Vani — Production Environment Variables
# Copy this file to .env.local and fill in real values before running locally
# Set these as Vercel Environment Variables in the Vercel dashboard

# ============================================================
# DATABASE — Neon Postgres
# Get from: https://neon.tech → Your Project → Connection String
# ============================================================
DATABASE_URL="postgresql://vrikshvani_owner:REPLACE_PASSWORD@ep-REPLACE_ENDPOINT.us-east-2.aws.neon.tech/vrikshvani?sslmode=require"

# ============================================================
# NEXTAUTH — Authentication
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# ============================================================
NEXTAUTH_URL="https://vrikshvani.com"
NEXTAUTH_SECRET="REPLACE_WITH_32_CHAR_SECRET"

# Optional OAuth providers (add when needed)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ============================================================
# EMAIL — Transactional emails (Resend recommended)
# Get from: https://resend.com
# ============================================================
RESEND_API_KEY="re_REPLACE_WITH_RESEND_KEY"
EMAIL_FROM="hello@vrikshvani.com"

# ============================================================
# ANALYTICS
# ============================================================
# @vercel/analytics is injected automatically — no env var needed

# ============================================================
# VERCEL — Set automatically by Vercel platform
# ============================================================
# VERCEL_URL — auto-set by Vercel (do not set manually)
# VERCEL_ENV — auto-set (production | preview | development)

# ============================================================
# NEXT.JS PERFORMANCE
# ============================================================
NODE_OPTIONS="--max-old-space-size=8192"
